[8.737954, "o", "\u001b[11;1H\u001b[38;5;153m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[12;2H\u001b[1mBash command\r\n\u001b[m\u000f \u001b[1mTip: auto mode handles these prompts for you — choose \"switch to auto mode\" below\u001b[m\u000f\u001b[K\r\n \u001b[38;5;246mRun npm test in the project directory\r\n\u001b[38;5;239m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[16;2H\u001b[39mnpm test 2>&1; echo \"EXIT=$?\"\u001b[K\r\n\u001b[38;5;239m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[18;2H\u001b[39mThis\u001b[Ccommand\u001b[Crequires\u001b[Capproval\u001b[20;2HDo\u001b[Cyou\u001b[Cwant\u001b[Cto\u001b[Cproceed?\u001b[21;2H\u001b[38;5;153m❯\u001b[C\u001b[38;5;246m1.\u001b[C\u001b[38;5;153mYes\u001b[22;4H\u001b[38;5;246m2.\u001b[C\u001b[39mYes,\u001b[Cand\u001b[Cdon't\u001b[Cask\u001b[Cagain\u001b[Cfor\u001b[C\u001b[1mnpm\u001b[Ctest\u001b[C\u001b[m\u000fand\u001b[C\u001b[1m\"echo\u001b[C\\\"EXIT=$?\\\"\"\u001b[C\u001b[m\u000fcommands\u001b[Cin\u001b[23;7H\u001b[1m/home/tizh/repos/projects/troupe-demo\u001b[24;4H\u001b[m\u000f\u001b[38;5;246m3.\u001b[C\u001b[39mYes,\u001b[Cand\u001b[Cswitch\u001b[Cto\u001b[Cauto\u001b[Cmode\u001b[38;5;246m ·\u001b[Cauto\u001b[Cmode\u001b[Chandles\u001b[Cthese\u001b[Cprompts\u001b[Cfor\u001b[Cyou\u001b[25;4H4.\u001b[C\u001b[39mNo\u001b[27;2H\u001b[38;5;246mEsc\u001b[Cto\u001b[Ccancel\u001b[C·\u001b[CTab\u001b[Cto\u001b[Camend\u001b[21;2H\u001b[?25l\u001b[m\u000f"]
