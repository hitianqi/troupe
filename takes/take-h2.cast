[10.751401, "o", "\u001b[7;1H\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[8;1H\u001b[38;5;16m\u001b[48;5;153m ☐ Footer style \u001b[39m\u001b[49m\u001b[K\u001b[10;1H\u001b[38;5;231m\u001b[1mShould the footer be plain text or include links?\u001b[m\u000f\u001b[K\r\n\u001b[K\r\n\u001b[38;5;153m❯\u001b[39m \u001b[38;5;246m1.\u001b[39m \u001b[38;5;153mPlain text (Recommended)\u001b[39m\u001b[K\u001b[13;3H   \u001b[38;5;246mA simple line\u001b[Cof tex\u001b[C,\u001b[Csuch as a\u001b[Ccopyright or tagline, with no clickable links.\u001b[14;3H2.\u001b[C\u001b[39mWith\u001b[Clinks\u001b[15;6H\u001b[38;5;246mText\u001b[Cplus\u001b[Cclickable\u001b[Clinks.\u001b[CI'll\u001b[Cask\u001b[Cwhich\u001b[Clinks\u001b[Cyou\u001b[Cwant\u001b[Cnext.\u001b[16;3H3.\u001b[CType\u001b[Csomething.\r\n────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[18;3H\u001b[39m4.\u001b[CChat\u001b[Cabout\u001b[Cthis\u001b[20;1H\u001b[38;5;246mEnter\u001b[Cto\u001b[Cselect\u001b[C·\u001b[C↑/↓\u001b[Cto\u001b[Cnavigate\u001b[C·\u001b[CEsc\u001b[Cto\u001b[Ccancel\u001b[12;1H\u001b[?25l\u001b[m\u000f"]
