[7.98133, "o", "\u001b[11;1H\u001b[38;5;153m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[12;2H\u001b[1mBash command\r\n\u001b[m\u000f \u001b[1mTip: auto mode handles these prompts for you — choose \"switch to auto mode\" below\u001b[m\u000f\u001b[K\r\n \u001b[38;5;246mCreate notes.txt and verify its contents\r\n\u001b[38;5;239m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[16;2H\u001b[39mprintf 'todo\\n' > notes.txt && cat notes.txt && git\u001b[Cstatus\u001b[C--short\r\n\u001b[38;5;239m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[18;2H\u001b[39mDo\u001b[Cyou\u001b[Cwant\u001b[Cto\u001b[Cproceed?\u001b[19;2H\u001b[38;5;153m❯\u001b[C\u001b[38;5;246m1.\u001b[C\u001b[38;5;153mYes\u001b[20;4H\u001b[38;5;246m2.\u001b[C\u001b[39mYes,\u001b[Cand\u001b[Calways\u001b[Callow\u001b[Caccess\u001b[Cto\u001b[C\u001b[1m/home/tizh/repos/projects/troupe-demo\u001b[C\u001b[m\u000ffrom\u001b[Cthis\u001b[Cproject\u001b[21;4H\u001b[38;5;246m3.\u001b[C\u001b[39mYes,\u001b[Cand\u001b[Cswitch\u001b[Cto\u001b[Cauto\u001b[Cmode\u001b[38;5;246m ·\u001b[Cauto\u001b[Cmode\u001b[Chandles\u001b[Cthese\u001b[Cprompts\u001b[Cfor\u001b[Cyou\u001b[22;4H4.\u001b[C\u001b[39mNo\u001b[24;2H\u001b[38;5;246mEsc\u001b[Cto\u001b[Ccancel\u001b[C·\u001b[CTab\u001b[Cto\u001b[Camend\u001b[19;2H\u001b[?25l\u001b[m\u000f"]
