[10.821415, "o", "\u001b[8;1H \u001b[C\u001b[38;5;246mSearched for \u001b[1m1\u001b[m\u000f\u001b[38;5;246m pattern (ctrl+o to expand)\u001b[39m\u001b[K\u001b[10;1H\u001b[38;5;231m●\u001b[C\u001b[38;5;153mlinks.js\u001b[39m turns a list\u001b[Cof \u001b[38;5;153m{label, url}\u001b[C\u001b[39mitems\u001b[Cinto\u001b[Clink\u001b[Cmodels,\u001b[Cwhere\u001b[C\u001b[38;5;153mhttps:\u001b[C\u001b[39mURLs\u001b[Copen\u001b[Cin\u001b[Ca\u001b[Cnew\u001b[Ctab\u001b[11;3Hwith\u001b[C\u001b[38;5;153mrel=\"noopener\"\u001b[39m.\u001b[CIn\u001b[Cthe\u001b[Cbrowser,\u001b[Cit\u001b[Cfetches\u001b[C\u001b[38;5;153mlinks.json\u001b[39m,\u001b[Crenders\u001b[Cthose\u001b[Clinks\u001b[Cinto\u001b[Cthe\u001b[C\u001b[38;5;153mul.links\r\n\u001b[39m  list, and shows \"Couldn't load the links.\" if the fetch fails.\u001b[K\r\n\u001b[K\r\n\u001b[38;5;174m✽\u001b[39m \u001b[38;5;180mSynthesizing…\u001b[38;5;174m \u001b[38;5;246m(running Stop hook · 3s · ↓\u001b[39m \u001b[38;5;246m144 tokens)\u001b[39m\u001b[K\u001b[15;3H\u001b[K\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[17;1H\u001b[38;5;246m❯ \r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[19;3H\u001b[38;5;220m⏵⏵\u001b[Cauto\u001b[Cmode\u001b[Con\u001b[38;5;246m (shift+tab\u001b[Cto\u001b[Ccycle)\u001b[C·\u001b[Cesc\u001b[Cto\u001b[Cinterrupt\u001b[C·\u001b[C←\u001b[C4\u001b[Cagents\u001b[17;3H\u001b[m\u000f"]
