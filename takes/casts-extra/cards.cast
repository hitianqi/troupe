Cempty\u001b[Ccontext;\u001b[Cprevious\u001b[Csession\u001b[Cstays\u001b[Con\u001b[Cdisk\u001b[C(resumable\u001b[Cwith\u001b[C/resume)\u001b[7;4H\u001b[m\u000ft\u001b[9;6H\u001b[38;5;153m\u001b[1mt\u001b[m\u000f\u001b[38;5;153mui                \u001b[23CSe\u001b[1mt\u001b[m\u000f\u001b[38;5;153m the terminal\u001b[CUI renderer (default | fullscr\u001b[Cen)\u001b[39m\u001b[K\u001b[10;3H\u001b[38;5;246m  /\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mheme                                     Change \u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mhe theme\u001b[39m\u001b[K\u001b[11;6H\u001b[1mt\u001b[m\u000f\u001b[38;5;246masks                     \u001b[16CVi\u001b[Cw and\u001b[Cman\u001b[Cge every\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mhing running in the backgrou\u001b[Cd\u001b[39m\u001b[K\u001b[12;3H\u001b[38;5;246m  /\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246meleport (tp)                             Send \u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mhis session to the cloud, or r\u001b[Csume one from claude.ai\u001b[39m\u001b[K\u001b[13;6H\u001b[1mt\u001b[41CT\u001b[14;76Ht\u001b[15;6Ht\u001b[41CT\u001b[16;48Ht\u001b[17;6Ht\u001b[m\u000f\u001b[38;5;246mro\u001b[Cp\u001b[2Cmission\u001b[28CR\u001b[Cn a\u001b[Cmul\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mi-step software\u001b[Cchange as \u001b[C troupe mission, with this session as the orchestrator. You write a\u001b[18;3H\u001b[39m                                             \u001b[38;5;246mplan wi\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mh\u001b[Cthe person, they approve it in the troupe panel, and each role then works in a real tmux window \u2026\u001b[19;6H\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246merminal-setup\u001b[28CIns\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246ma\u001b[Cl Shift+Enter key binding for\u001b[Cnewlines\u001b[39m\u001b[K\u001b[20;6H\u001b[1mt\u001b[m\u000f\u001b[38;5;246mianqi-showcase\u001b[27C\u001b[39m\u001b[1mT\u001b[m\u000f\u001b[38;5;246murn one of\u001b[CTianqi's old,\u001b[Chalf-broken or no-UI projects (internship work, course projects, side projects)\u001b[21;3H\u001b[39m                                             \u001b[38;5;246min\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mo por\u001b[Cfolio m\u001b[Cterial - a 60 t\u001b[C 90 second screen-record\u001b[Cd d\u001b[Cmo and a short project page - by staging the\u2026\u001b[22;6H\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246meam-\u001b[Cnboarding\u001b[27CH\u001b[Clp \u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246meammates ramp on Claude\u001b[CCode with a g\u001b[Cide from your usage\u001b[23;6H\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mianq\u001b[C-launch-film\u001b[25Cake a 30\u201340 s cinem\u001b[C\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mic product launch\u001b[Cfilm (MP4 with music) in the style of the Manus 2.0 / Grok Bot\u001b[24;3H\u001b[39m                                             \u001b[38;5;246mlaunch video\u001b[C. Real UI is shown o\u001b[C \u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246milted 3D\u001b[Cplanes w\u001b[Cth a gliding camera and tilt-shift depth of field; p\u2026\u001b[25;6H\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mi\u001b[2Cqi-skill-design\u001b[23CDecid\u001b[2Cwha\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246m belongs inside a skill and \u2014 more often\u001b[C\u2014 what must be kept out of it. Use when writing a new\u001b[26;3H\u001b[39m                                             \u001b[38;5;246mskill\u001b[Cfrom scra\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mch, ed\u001b[Cting or trimming an exis\u001b[Cing one, re\u001b[Ciewing a SKILL.md someone else wrote, deciding\u2026\u001b[27;6H\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mianqi-product-demo\u001b[23C\u5236\u4f5c\u4ee5\u771f\u5b9e\u8f6f\u4ef6\u754c\u9762\u4e3a\u4e3b\u4f53\u7684\u4ea7\u54c1\u6f14\u793a\u5ba3\u4f20\u89c6\u9891\uff0c\u590d\u7528\u6697\u8272\u6e10\u53d8\u821e\u53f0\u3001\u7a97\u53e3\u63a8\u8fd1\u5e73\u79fb\u3001\u5c40\u90e8\u9ad8\u4eae\u3001\u64cd\u4f5c\u7ed3\u679c\u4e0e\u54c1\u724c\u6536\u5c3e\u3002\u001b[28;3H\u001b[39m                                             \u001b[38;5;246m\u9002\u7528\u4e8e\u201c\u505a\u7c7b\u4f3c MacPrune\u001b[C\u53c2\u8003\u7247\u7684 video\u201d\u3001\u8f6f\u4ef6\u53d1\u5e03\u77ed\u7247\u3001SaaS \u6216\u684c\u9762 App \u529f\u80fd\u5ba3\u4f20\uff1b\u4e0d\u9002\u7528\u4e8e\u771f\u4eba\u53e3\u64ad\u6216\u5f71\u89c6\u5267\u60c5\u2026\u001b[29;6H\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mianqi-writing-voice\u001b[22CDraf\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246m outbound\u001b[Ctext in Tianqi's own voice instead of the assistant's default register. Use whenever writing\u001b[30;3H\u001b[39m                                             \u001b[38;5;246msome\u001b[39m\u001b[1mt\u001b[m\u000f\u001b[38;5;246mhing that w\u001b[Cll\u001b[Cbe sent under Tianqi's name \u2014 Slack messages and channel posts, merge-request descript\u2026\u001b[7;5H\u001b[m\u000fr\u001b[9;7H\u001b[38;5;153m\u001b[1mr\u001b[m\u000f\u001b[38;5;153moupe-mission\u001b[28CRun\u001b[Ca multi-step\u001b[Csoftwar\u001b[C chang\u001b[C \u001b[Cs a\u001b[C\u001b[1mtr\u001b[m\u000f\u001b[38;5;153mo\u001b[Cpe mission, with this session as the orchestrator. You write a\u001b[10;3H\u001b[39m                                             \u001b[38;5;153mplan with the person, they approve it in the \u001b[1mtr\u001b[m\u000f\u001b[38;5;153moupe panel, and each role then works in a real tmux window \u2026\u001b[11;6H\u001b[38;5;246mcodex:\u001b[39m\u001b[1mtr\u001b[m\u000f\u001b[38;5;246mansfer\u001b[28C(codex) \u001b[39m\u001b[1mTr\u001b[2C\u001b[m\u000f\u001b[38;5;246msf\u001b[Cr the current Claude Code session i\u001b[Cto a resumable Codex thread\u001b[12;6Hr\u001b[Cmote-con\u001b[39m\u001b[1mtr\u001b[m\u000f\u001b[38;5;246mol\u001b[28CCo\u001b[C\u001b[39m\u001b[1mtr\u001b[m\u000f\u001b[38;5;246mol this \u001b[Cession\u001b[Cfrom y\u001b[2Cr phone