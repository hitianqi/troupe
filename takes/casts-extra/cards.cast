05;145m\u25fb\u25fb\u25fb\u001b[38;2;154;163;173m medium\u001b[39m  \u001b[38;2;154;163;173mstarts at once                        \u001b[39m \u001b[38;2;244;190;92m\u2502\u001b[24;67H\u2502\u001b[39m    Light/dark styles\u001b[Cand the theme toggle with system default and memory               \u001b[38;2;244;190;92m\u2502\u001b[25;67H\u2502\u001b[39m    \u001b[38;2;78;105;145mstyles.css  theme.js  tests/theme.test.js\u001b[39m                                           \u001b[38;2;244;190;92m\u2502\u001b[26;67H\u2502\u001b[39m                     \u001b[67C\u001b[38;2;244;190;92m\u2502\u001b[27;67H\u2502\u001b[39m  \u001b[38;2;101;203;212m\u2b22\u001b[39m \u001b[38;2;232;234;240m\u001b[1mreview     \u001b[m\u000f\u001b[38;2;154;163;173mcodex gpt-5.6-sol   \u001b[38;2;111;168;255m\u25fc\u25fc\u25fc\u001b[38;2;78;105;145m\u25fb\u25fb\u001b[38;2;154;163;173m high\u001b[39m    \u001b[38;2;154;163;173mas each lands                         \u001b[39m \u001b[38;2;244;190;92m\u2502\u001b[28;67H\u2502\u001b[39m    Review each branch as it lands          \u001b[44C\u001b[38;2;244;190;92m\u2502\u001b[29;67H\u2502\u001b[39m    \u001b[38;2;78;105;145mchanges nothing\u001b[39m  \u001b[67C\u001b[38;2;244;190;92m\u2502\u001b[30;67H\u2502\u001b[39m                     \u001b[67C\u001b[38;2;244;190;92m\u2502\u001b[31;67H\u2502\u001b[39m \u001b[38;2;78;105;145m\u2500 DECISIONS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[38;2;244;190;92m\u2502\u001b[32;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  1  \u001b[39mWhich links?\u001b[38;2;152;195;121m \u2192 placeholders\u001b[39m           \u001b[44C\u001b[38;2;244;190;92m\u2502\u001b[33;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  2  \u001b[39mHow dark mode works.\u001b[38;2;152;195;121m \u2192 follow the system setting, plus a toggle whose choice is\u001b[39m   \u001b[38;2;244;190;92m\u2502\u001b[34;67H\u2502\u001b[39m      \u001b[38;2;152;195;121mremembered in `localStorage`\u001b[39m          \u001b[44C\u001b[38;2;244;190;92m\u2502\u001b[35;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  3  \u001b[39mHow the page reads \u001b[38;2;111;168;255mlinks.json\u001b[39m.\u001b[38;2;152;195;121m \u2192 `links.js` fetches it at load\u001b[39m                    \u001b[38;2;244;190;92m\u2502\u001b[36;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  4  \u001b[39mWho runs the roles.\u001b[38;2;152;195;121m \u2192 Claude Sonnet for both builders, Codex for the review\u001b[39m       \u001b[38;2;244;190;92m\u2502\u001b[37;67H\u2502\u001b[39m                     \u001b[67C\u001b[38;2;244;190;92m\u2502\u001b[38;67H\u2502\u001b[39m \u001b[38;2;78;105;145m\u2500 OUT OF SCOPE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[38;2;244;190;92m\u2502\u001b[39;67H\u2502\u001b[39m  Real content beyond\u001b[Cplaceholders, analytics, a build step, any framework or npm       \u001b[38;2;244;190;92m\u2502\u001b[40;67H\u2502\u001b[39m  dependency, deployment.                   \u001b[44C\u001b[38;2;244;190;92m\u2502\u001b[41;67H\u2502\u001b[39m                     \u001b[67C\u001b[38;2;244;190;92m\u2502\u001b[42;3H\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1006h\u001b[?1000h\u001b[?1002h\u001b[m\u000f\u001b[64C\u001