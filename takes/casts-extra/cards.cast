1b[39m \u001b[38;2;154;163;173mWhy    \u001b[39mThe page is only a title today      \u001b[44C\u001b[38;2;244;190;92m\u2502\u001b[8;67H\u2502\u001b[39m                     \u001b[67C\u001b[38;2;244;190;92m\u2502\u001b[9;67H\u2502\u001b[39m \u001b[38;2;78;105;145m\u2500 DONE WHEN \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[38;2;244;190;92m\u2502\u001b[10;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  1  \u001b[39mThe page shows a header and the links from \u001b[38;2;111;168;255mlinks.json\u001b[39m, each opening its target    \u001b[38;2;244;190;92m\u2502\u001b[11;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  2  \u001b[39mEditing \u001b[38;2;111;168;255mlinks.json\u001b[39m alone changes the links on the page                            \u001b[38;2;244;190;92m\u2502\u001b[12;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  3  \u001b[39mThe page follows the system light/dark\u001b[Csetting on first visit                     \u001b[38;2;244;190;92m\u2502\u001b[13;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  4  \u001b[39mA toggle switches the theme, and the choice survives a reload                     \u001b[38;2;244;190;92m\u2502\u001b[14;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  5  \u001b[39mThe page works at phone width with no sideways scroll                             \u001b[38;2;244;190;92m\u2502\u001b[15;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  6  \u001b[38;2;111;168;255mnpm test\u001b[39m passes, with tests for the link data, the rendering and the theme logic  \u001b[38;2;244;190;92m\u2502\u001b[16;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  7