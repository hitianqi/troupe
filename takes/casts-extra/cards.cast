K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[34h\u001b[?25h\u001b[7;3H/\u001b[K\u001b[9;3H\u001b[38;5;153m\u276f /prover-git-workflow                       Prover's git and GitLab workflow for repositories hosted on git.i.prover.com: branch naming (`feature/` or\u001b[10;48H`bugfix/`\u001b[Cplus\u001b[Cthe\u001b[Cticket\u001b[Ckey),\u001b[Ccommit\u001b[Cmessages\u001b[Cand\u001b[Cthe\u001b[CAI\u001b[C`Co-Authored-By`\u001b[Ctrailer,\u001b[Csemi-linear\u001b[Chistory\u001b[C(\u2026\u001b[11;3H\u001b[38;5;246m \u001b[C/tianqi-project-maintenance\u001b[16CUse\u001b[Cwhen\u001b[Ccreating\u001b[Ca\u001b[Cproject,\u001b[Ctaking\u001b[Cover\u001b[Can\u001b[Cexisting\u001b[Crepository,\u001b[Cor\u001b[Cimproving\u001b[Chow\u001b[Ca\u001b[Cproject\u001b[Cis\u001b[Cmaintained:\u001b[12;48Hprovides\u001b[Cproject\u001b[Ctemplates\u001b[Ccompatible\u001b[Cwith\u001b[Cboth\u001b[CCodex\u001b[Cand\u001b[CClaude\u001b[CCode,\u001b[Cturns\u001b[Cengineering\u001b[Crules\u001b[Cinto\u001b[Ctypes,\u2026\u001b[13;3H \u001b[C/tianqi-ui-ux\u001b[30CTianqi's\u001b[CUI\u001b[Cand\u001b[CUX\u001b[Ctaste\u001b[Cfor\u001b[Cweb\u001b[Cpages\u001b[Che\u001b[Cowns\u001b[C(Prover\u001b[CLabs\u001b[Cfirst\u001b[Cof\u001b[Call),\u001b[Clearned\u001b[Cthe\u001b[Chard\u001b[Cway\u001b[Cover\u001b[Cthe\u001b[14;48Hlanding-page\u001b[Credesign.\u001b[CUse\u001b[Cit\u001b[Cwhenever\u001b[Cdesigning,\u001b[Credesigning,\u001b[Cmocking\u001b[Cup\u001b[Cor\u001b[Cpolishing\u001b[Ca\u001b[Cpage,\u001b[Ca\u001b[Csection\u001b[Co\u2026\u001b[15;3H \u001b[C/tianqi-taste\u001b[30CTianqi's\u001b[Cvisual\u001b[Ctaste\u001b[Cfor\u001b[Cevery\u001b[Cfrontend\u001b[Che\u001b[Cbuilds,\u001b[CProver\u001b[Cor\u001b[Cnot,\u001b[Ccovering\u001b[Cwhat\u001b[Ca\u001b[Cpage\u001b[Cshould\u001b[Clook\u001b[Clike\u001b[C-\u001b[16;48Htypography,\u001b[Ccolour\u001b[Cand\u001b[Catmosphere,\u001b[Cgradients\u001b[Cand\u001b[Cglows,\