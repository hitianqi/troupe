44;190;92m\u2502\u001b[36;67H\u2502\u001b[39m \u001b[38;2;154;163;173m  4  \u001b[39mWho runs the roles.\u001b[38;2;152;195;121m \u2192 Claude Sonnet for both builders, Codex for the review\u001b[39m       \u001b[38;2;244;190;92m\u2502\u001b[37;67H\u2502\u001b[39m                     \u001b[67C\u001b[38;2;244;190;92m\u2502\u001b[38;67H\u2502\u001b[39m \u001b[38;2;78;105;145m\u2500 OUT OF SCOPE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[38;2;244;190;92m\u2502\u001b[39;67H\u2502\u001b[39m  Real content beyond\u001b[Cplaceholders, analytics, a build step, any framework or npm       \u001b[38;2;244;190;92m\u2502\u001b[40;67H\u2502\u001b[39m  dependency, deployment.                   \u001b[44C\u001b[38;2;244;190;92m\u2502\u001b[41;67H\u2502\u001b[39m                     \u001b[67C\u001b[38;2;244;190;92m\u2502\u001b[42;35H\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1006h\u001b[?1000h\u001b[?1002h\u001b[m\u000f\u001b[32C\u001b[38;2;244;190;92m\u2502\u001b[m\u000f\u001b[34h\u001b[?25h\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[1;1H\u001b[1;45r\u001b[42;68H \u001b[38;2;154;163;173mdocs/missions/link-page/plan.md  \u00b7  sha256:a8aa\u2026  \u00b7  \u001b[38;2;152;195;121mchecks clean\u001b[39m                      \u001b[38;2;244;190;92m\u2502\u001b[43;67H\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500