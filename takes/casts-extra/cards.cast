              \u001b[67C\u001b[38;2;244;190;92m\u2502\u001b[43;67H\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[45;67H\u001b[38;2;154;163;173m a  approve   c  change   v  plan   \u2191\u2193  role   1-5  tabs   ?  help                        \u001b[42;3H\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1006h\u001b[?1000h\u001b[?1002h\u001b[m\u000f\u001b[38;18H\u001b[38;5;246m20\u001b[42;3H\u001b[m\u000f\u001b[4A\u001b[38;5;216mEmbellishing\u2026\u001b[42;3H\u001b[m\u000f\u001b[38;1H\u001b[38;5;174m\u2722\u001b[42;3H\u001b[m\u000f\u001b[38;1H\u001b[38;5;174m*\u001b[42;3H\u001b[m\u000f\u001b[38;1H\u001b[38;5;174m\u2736\u001b[42;3H\u001b[m\u000f\u001b[38;1H\u001b[38;5;174m\u273b\u001b[42;3H\u001b[m\u000f\u001b[4A\u001b[38;5;174mE\u001b[3Cllishing\u2026\u001b[42;3H\u001b[m\u000f\u001b[38;1H\u001b[38;5;231m\u25cf\u001b[42;3H\u001b[m\u000f\u001b[?25l\u001b[1;5H\u001b[1K\u001b[38;5;77m\u001b[48;5;22m\u001b[C 48 +\u001b[38;5;231m\u001b[48;5;28mfiles\u001b[48;5;22m; the existing smoke test stays as it is.  \u001b[39m\u001b[49m       \u001b[2;65H\u001b[1K\u001b[5G\u001b[1K\u001b[38;5;231m\u001b[2m\u001b[C 49\u001b[m\u000f \u001b[38;5;231m \u001b[39m\u001b[3;65H\u001b[1K\u001b[5G\u001b[1K\u001b[38;5;231m\u001b[2m\u001b[C 50\u001b[m\u000f \u001b[38;5;231m Contract:\u001b[39m\u001b[4;65H\u001b[1K\u001b[5G\u001b[1K\u001b[38;5;231m\u001b[2m\u001b[C 51\u001b[m\u000f \u001b[38;5;231m \u001b[39m\u001b[5;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 52 -\u001b[38;5;231m- `<html>` gets `data-theme=\"light|dark\"` set by\u001b[39m\u001b[49m       \u001b[6;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231m `theme.js`; CSS colours are                    \u001b[39m\u001b[49m       \u001b[7;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 53 -\u001b[38;5;231m  tokens on `:root`, redefined under `[data-them\u001b[39m\u001b[49m       \u001b[8;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231me=\"dark\"]`.                                     \u001b[39m\u001b[49m       \u001b[9;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 54 -\u001b[38;5;231m- Markup: `<header>` with `<h1>`, a tagline `<p>\u001b[39m\u001b[49m       \u001b[10;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231m` and                                           \u001b[39m\u001b[49m       \u001b[11;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 55 -\u001b[38;5;231m  `<button id=\"theme-toggle\" type=\"button\" aria-\u001b[39m\u001b[49m       \u001b[12;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231mlabel=\"Toggle dark mode\">`;                     \u001b[39m\u001b[49m       \u001b[13;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 56 -\u001b[38;5;231m  `<main>` with `<ul class=\"links\">` of `<li><a \u001b[39m\u001b[49m       \u001b[14;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231mclass=\"link\" href=\"\u2026\">`.                        \u001b[39m\u001b[49m       \u001b[15;5H\u001b[1K\u001b[38;5;246m\u001b[C\u2026\u001b[39m \u001b[38;5;246m140\u001b[39m \u001b[38;5;246mmore\u001b[39m \u001b[38;5;246mlines\u001b[39m \u001b[38;5;246m(ctrl+o\u001b[39m \u001b[38;5;246mto\u001b[39m \u001b[38;5;246mexpand)\u001b[39m                         \u001b[38;5;246m\r\n \u001b[39m \u001b[38;5;246m\u23bf\u001b[39m \u001b[38;5;246m\u00a0(files\u001b[39m \u001b[38;5;246mthat\u001b[39m \u001b[38;5;246mchanged\u001b[39m \u001b[38;5;246mwhile\u001b[39m \u001b[38;5;246mthis\u001b[39m \u001