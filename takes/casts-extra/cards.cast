\u001b[6;79H  - \u001b[1mTests:\u001b[m\u000f \u001b[38;5;153mtests/page.test.js\u001b[39m and \u001b[38;5;153mtests/theme.test.js\u001b[39m cover what the brief\u001b[K\u001b[7;79H    lists.\u001b[K\u001b[8;79H  - \u001b[1mNode/browser\u001b[m\u000f \u001b[1mpattern:\u001b[m\u000f the package is \u001b[38;5;153mtype:\u001b[39m \u001b[38;5;153mmodule\u001b[39m, so the browser scripts\u001b[K\u001b[9;79H    can't use \u001b[38;5;153mmodule.exports\u001b[39m. Instead each one assigns its pure function\u001b[K\u001b[10;79H    (\u001b[38;5;153mpickTheme\u001b[39m, \u001b[38;5;153mlinkModels\u001b[39m) to \u001b[38;5;153mglobalThis\u001b[39m, and the tests import the file and\u001b[K\u001b[11;79H    read it from there. This is documented in a comment in each script.\u001b[K\u001b[12;79H\u001b[K\n  The result file is at \u001b[38;5;153m.troupe/result.md\u001b[39m and, as the brief says, isn't\u001b[K\u001b[14;79H  committed.\u001b[K\u001b[15;79H\u001b[K\u001b[38;5;246m\n\u273b\u001b[39m \u001b[38;5;246mBrewed for 37s \u00b7 done 7:54 PM\u001b[39m\u001b[K\u001b[17;79H\u001b[K\u001b[38;5;244m\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[19;79H\u276f\u00a0\u001b[K\u001b[38;5;244m\u001b[20;79H\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2