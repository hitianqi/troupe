;163;173m  1  \u001b[39mWhich links?\u001b[38;2;152;195;121m → placeholders\u001b[39m           \u001b[44C\u001b[38;2;244;190;92m│\u001b[33;67H│\u001b[39m \u001b[38;2;154;163;173m  2  \u001b[39mHow dark mode works.\u001b[38;2;152;195;121m → follow the system setting, plus a toggle whose choice is\u001b[39m   \u001b[38;2;244;190;92m│\u001b[34;67H│\u001b[39m      \u001b[38;2;152;195;121mremembered in `localStorage`\u001b[39m          \u001b[44C\u001b[38;2;244;190;92m│\u001b[35;67H│\u001b[39m \u001b[38;2;154;163;173m  3  \u001b[39mHow the page reads \u001b[38;2;111;168;255mlinks.json\u001b[39m.\u001b[38;2;152;195;121m → `links.js` fetches it at load\u001b[39m                    \u001b[38;2;244;190;92m│\u001b[36;67H│\u001b[39m \u001b[38;2;154;163;173m  4  \u001b[39mWho runs the roles.\u001b[38;2;152;195;121m → Claude Sonnet for both builders, Codex for the review\u001b[39m       \u001b[38;2;244;190;92m│\u001b[37;67H│\u001b[39m                     \u001b[67C\u001b[38;2;244;190;92m│\u001b[38;67H│\u001b[39m \u001b[38;2;78;105;145m─ OUT OF SCOPE ───────────────────────────────────────────────────────────────────────\u001b[39m \u001b[38;2;244;190;92m│\u001b[39;67H│\u001b[39m  Real content beyond\u001b[Cplaceholders, analytics, a build step, any framework or npm       \u001b[38;2;244;190;92m│\u001b[40;67H│\u001b[39m  dependency, deployment.                   \u001b[44C\u001b[38;2;244;190;92m│\u001b[41;67H│\u001b[39m                     \u001b[67C\u001b[38;2;244;190;92m│\u001b[42;3H\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1006h\u001b[?1000h\u001b[?1002h\u001b[m\u000f"]
