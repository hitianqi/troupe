ilder\u001b[Cand\u001b[Cpush\u001b[Cthe\u001b[Cfix\u001b[Cto\u001b[Cthe\u001b[Csame\u001b[CPR.\u001b[COnce\u001b[Cyou've\u001b[Cmerged\u001b[Cit,\u001b[Capprove\u001b[Cthe\u001b[Cgate\u001b[Cand\u001b[CI'll\u001b[Cclean\u001b[Cup\u001b[Cthe\u001b[Cmission's\u001b[30;3Hwindows,\u001b[Cworktrees\u001b[Cand\u001b[Crole\u001b[Cbranches.\u001b[32;1H\u001b[38;5;246m✻\u001b[CWorked\u001b[Cfor\u001b[C16s\u001b[C·\u001b[Cdone\u001b[C8:12\u001b[CPM\u001b[34;1H\u001b[48;5;237m❯ \u001b[38;5;231mmerged approved in the panel. Run troupe stage teardown -m link-page and troupe teardown -m link-page, then report the cleanup.\u001b[39m                           \u001b[36;1H\u001b[49m\u001b[38;5;246m●\u001b[C\u001b[39m\u001b[1mBash\u001b[m\u000f(cd\u001b[C/home/tizh/repos/projects/troupe-demo\u001b[C&&\u001b[Cgh\u001b[Cpr\u001b[?25l"]
