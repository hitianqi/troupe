[100.271979, "o", "\u001b[1;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 44 -\u001b[38;5;231mTwo builders that run at once, plus a reviewer. \u001b[39m\u001b[49m       \u001b[2;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231m`page` owns the content                         \u001b[39m\u001b[49m       \u001b[3;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 45 -\u001b[38;5;231mside: `index.html` (the one hub file), `links.js\u001b[39m\u001b[49m       \u001b[4;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231mon`, `links.js` and                             \u001b[39m\u001b[49m       \u001b[5;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 46 -\u001b[38;5;231m`package.json`. `theme` owns the look: `styles.c\u001b[39m\u001b[49m       \u001b[6;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231mss` and `theme.js`. They                        \u001b[39m\u001b[49m       \u001b[7;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 47 -\u001b[38;5;231mshare no file; they meet at the contract below, \u001b[39m\u001b[49m       \u001b[8;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231mwhich both build to. Each                       \u001b[39m\u001b[49m       \u001b[9;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 48 -\u001b[38;5;231mrole writes its own test file; the existing smok\u001b[39m\u001b[49m       \u001b[10;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231me test stays as it is.                          \u001b[39m\u001b[49m       \u001b[11;5H\u001b[1K\u001b[38;5;77m\u001b[48;5;22m\u001b[C 44 +\u001b[38;5;231mA chain of two builders, plus a reviewer. `data`\u001b[39m\u001b[49m       \u001b[12;5H\u001b[1K\u001b[38;5;77m\u001b[48;5;22m\u001b[C    +\u001b[38;5;231m writes `links.json` first.                     \u001b[39m\u001b[49m       \u001b[13;5H\u001b[1K\u001b[38;5;77m\u001b[48;5;22m\u001b[C 45 +\u001b[38;5;231m`page` waits on it, because it renders from that\u001b[39m\u001b[49m       \u001b[14;5H\u001b[1K\u001b[38;5;77m\u001b[48;5;22m\u001b[C    +\u001b[38;5;231m file and tests against it;                     \u001b[39m\u001b[49m       \u001b[15;5H\u001b[1K\u001b[38;5;77m\u001b[48;5;22m\u001b[C 46 +\u001b[38;5;231m`page` owns everything else: `index.html` (the o\u001b[39m\u001b[49m       \u001b[16;5H\u001b[1K\u001b[38;5;77m\u001b[48;5;22m\u001b[C    +\u001b[38;5;231mne hub file), `links.js`,                       \u001b[39m\u001b[49m       \u001b[17;5H\u001b[1K\u001b[38;5;77m\u001b[48;5;22m\u001b[C 47 +\u001b[38;5;231m`styles.css`, `theme.js` and `package.json`. Eac\u001b[39m\u001b[49m       \u001b[18;5H\u001b[1K\u001b[38;5;77m\u001b[48;5;22m\u001b[C    +\u001b[38;5;231mh role writes its own test                      \u001b[39m\u001b[49m       \u001b[19;5H\u001b[1K\u001b[38;5;77m\u001b[48;5;22m\u001b[C 48 +\u001b[38;5;231m\u001b[48;5;28mfiles\u001b[48;5;22m; the existing smoke test stays as it is.  \u001b[39m\u001b[49m       \u001b[20;65H\u001b[1K\u001b[5G\u001b[1K\u001b[38;5;231m\u001b[2m\u001b[C 49\u001b[m\u000f \u001b[38;5;231m \u001b[39m\u001b[21;65H\u001b[1K\u001b[5G\u001b[1K\u001b[38;5;231m\u001b[2m\u001b[C 50\u001b[m\u000f \u001b[38;5;231m Contract:\u001b[39m\u001b[22;65H\u001b[1K\u001b[5G\u001b[1K\u001b[38;5;231m\u001b[2m\u001b[C 51\u001b[m\u000f \u001b[38;5;231m \u001b[39m\u001b[23;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 52 -\u001b[38;5;231m- `<html>` gets `data-theme=\"light|dark\"` set by\u001b[39m\u001b[49m       \u001b[24;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231m `theme.js`; CSS colours are                    \u001b[39m\u001b[49m       \u001b[25;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 53 -\u001b[38;5;231m  tokens on `:root`, redefined under `[data-them\u001b[39m\u001b[49m       \u001b[26;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231me=\"dark\"]`.                                     \u001b[39m\u001b[49m       \u001b[27;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 54 -\u001b[38;5;231m- Markup: `<header>` with `<h1>`, a tagline `<p>\u001b[39m\u001b[49m       \u001b[28;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231m` and                                           \u001b[39m\u001b[49m       \u001b[29;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 55 -\u001b[38;5;231m  `<button id=\"theme-toggle\" type=\"button\" aria-\u001b[39m\u001b[49m       \u001b[30;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231mlabel=\"Toggle dark mode\">`;                     \u001b[39m\u001b[49m       \u001b[31;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C 56 -\u001b[38;5;231m  `<main>` with `<ul class=\"links\">` of `<li><a \u001b[39m\u001b[49m       \u001b[32;5H\u001b[1K\u001b[38;5;167m\u001b[48;5;52m\u001b[C    -\u001b[38;5;231mclass=\"link\" href=\"…\">`.                        \u001b[39m\u001b[49m       \u001b[33;5H\u001b[1K\u001b[38;5;246m\u001b[C…\u001b[39m \u001b[38;5;246m140\u001b[39m \u001b[38;5;246mmore\u001b[39m \u001b[38;5;246mlines\u001b[39m \u001b[38;5;246m(ctrl+o\u001b[39m \u001b[38;5;246mto\u001b[39m \u001b[38;5;246mexpand)\u001b[39m                         \u001b[38;5;246m\r\n \u001b[39m \u001b[38;5;246m⎿\u001b[39m \u001b[38;5;246m (files\u001b[39m \u001b[38;5;246mthat\u001b[39m \u001b[38;5;246mchanged\u001b[39m \u001b[38;5;246mwhile\u001b[39m \u001b[38;5;246mthis\u001b[39m \u001b[38;5;246mcommand\u001b[39m \u001b[38;5;246mran,\u001b[39m \u001b[38;5;246mby\u001b[39m \u001b[38;5;246mthe\u001b[39m          \u001b[35;5H\u001b[1K\u001b[38;5;246m\u001b[Ccommand\u001b[39m \u001b[38;5;246mor\u001b[39m \u001b[38;5;246mby\u001b[39m \u001b[38;5;246manother\u001b"]
