[15.506276, "o", "\u001b[15;1H \u001b[C\u001b[38;5;246mSearched for \u001b[1m1\u001b[m\u000f\u001b[38;5;246m pattern (ctrl+o to expand)\u001b[39m\u001b[K\u001b[17;1H\u001b[38;5;231m●\u001b[C\u001b[39mHere are three names for the page:\u001b[K\u001b[19;1H  1. \u001b[1mLink Shelf\u001b[m\u000f: short and literal. It reads as a shelf of places to visit, which suits a page of\u001b[K\r\n  \u001b[3Cfour\u001b[Cor\u001b[Cfive\u001b[Clinks.\r\n  2. \u001b[1mFind Me Here\u001b[m\u000f: says what the page is for, a single place that points to all your profiles and\u001b[K\u001b[22;3H   writing.\u001b[K\u001b[23;3H3.\u001b[C\u001b[1mTianqi's\u001b[CLinks\u001b[m\u000f:\u001b[Cpersonal\u001b[Cand\u001b[Cclear\u001b[Cfor\u001b[Ca\u001b[Clink\u001b[Cpage\u001b[Cwith\u001b[Cyour\u001b[Cname\u001b[Con\u001b[Cit.\u001b[CIf\u001b[Cyou'd\u001b[Crather\u001b[Cnot\u001b[24;6Huse\u001b[Cyour\u001b[Cname\u001b[Cin\u001b[Cthe\u001b[Ctitle,\u001b[Cthe\u001b[Cfirst\u001b[Ctwo\u001b[Cwork\u001b[Cbetter.\u001b[26;1H\u001b[38;5;174m✢\u001b[CSlithering…\u001b[C\u001b[38;5;246m(running\u001b[CStop\u001b[Chook\u001b[C·\u001b[C7s\u001b[C·\u001b[C↓\u001b[C699\u001b[Ctokens\u001b[C·\u001b[C\u001b[38;5;249mthinking\u001b[38;5;246m)\u001b[28;1H\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[28;1H\n\u001b[K\u001b[38;5;246m❯ \u001b[39m\r\n\u001b[K\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[28;1H\n\u001b[K\u001b[2C\u001b[38;5;220m⏵⏵\u001b[Cauto\u001b[Cmode\u001b[Con\u001b[38;5;246m (shift+tab\u001b[Cto\u001b[Ccycle)\u001b[C·\u001b[Cesc\u001b[Cto\u001b[Cinterrupt\u001b[C·\u001b[C←\u001b[39m\r\n\u001b[27;63H\u001b[38;5;246m4\u001b[Cagents\u001b[39m\r\n\u001b[K\u001b[25;3H"]
